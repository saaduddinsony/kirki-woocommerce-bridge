<?xml version="1.0"?>
<ruleset name="Kirki WooCommerce Bridge">
	<description>WordPress Coding Standards for Kirki WooCommerce Bridge.</description>
	<file>kirki-woocommerce-bridge.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.5"/>

	<rule ref="WordPress">
		<!-- PSR-4-ish class file names via our autoloader are WordPress style already. -->
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Hook callbacks must accept the arguments WordPress passes. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="read_product"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="kirki-woocommerce-bridge"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="kirki_woo"/>
				<element value="KirkiWoo"/>
				<element value="KIRKI_WOO"/>
			</property>
		</properties>
	</rule>
</ruleset>
